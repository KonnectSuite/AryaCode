{
    "name":  "@aryacode/dsh-arya-app",
    "description":  "AryaCode product bundle: the upstream web surface plus the AryaCode plugin market",
    "version":  "0.2.1-rc.3",
    "private":  true,
    "type":  "module",
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/KonnectSuite/AryaCode.git",
